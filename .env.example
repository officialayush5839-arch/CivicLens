# ============================================================================
# CivicLens Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local environment.
# ============================================================================

# Database Configuration
# Supported types: "sqlite" (zero setup) or "mysql"
DB_TYPE=sqlite

# SQLite Options (used when DB_TYPE=sqlite or during fallback)
SQLITE_DB_PATH=civiclens.db

# MySQL Options (used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=civiclens_db
DB_USER=civiclens_user
DB_PASSWORD=YourSecurePasswordHere
DB_URL=jdbc:mysql://localhost:3306/civiclens_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Auto-Fallback: When DB_TYPE=mysql, automatically fall back to SQLite if MySQL is unreachable
DB_AUTO_FALLBACK=true

# Application Mode
# Set to true to enable synthetic demo data and zero-setup interactive demonstration mode
APP_DEMO_MODE=false
APP_ENV=development

# Security / Authentication
BCRYPT_ROUNDS=12
